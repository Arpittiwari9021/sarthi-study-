# Recommended: OpenRouter free model router. Create a key at openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
APP_URL=http://localhost:3000

# Optional local AI fallback. Example: Ollama running on your PC.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Optional paid/other provider retained for future use
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
